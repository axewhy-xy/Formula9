*.mdb.meta

# Crash and build artefacts
sysinfo.txt
crashlytics-buildid.txt
*.apk
*.aab
*.unitypackage
*.app

# Local-only secrets and test output
.env
*.env
# Committed on purpose: the team shares this connection in a private repository.
!backend/.env
TestResults*.xml
/.tools/

# Python environments, generated caches, optional datasets and live session data.
.venv/
# The native traffic engine, built per machine by Tools/build_native.py
backend/src/traffic/_traffic_native*.pyd
backend/src/traffic/_traffic_native*.so
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
/data/
/state/
*.sqlite
# The imported LTA bus data is shared, so nobody else needs a DataMall key.
!backend/fixtures/transit/transit.sqlite
!backend/fixtures/buildings/*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite.lock
