{
  "$defs": {
    "CameraBookmark": {
      "additionalProperties": true,
      "properties": {
        "camera_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Camera Id",
          "type": "string"
        },
        "position_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Position M",
          "type": "array"
        },
        "target_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Target M",
          "type": "array"
        }
      },
      "required": [
        "camera_id",
        "position_m",
        "target_m"
      ],
      "title": "CameraBookmark",
      "type": "object"
    },
    "Proxy": {
      "additionalProperties": true,
      "properties": {
        "classification": {
          "enum": [
            "ROAD_SUPPORT",
            "BLOCKING",
            "NON_OPERATIONAL"
          ],
          "title": "Classification",
          "type": "string"
        },
        "dimensions_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Dimensions M",
          "type": "array"
        },
        "entity_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Entity Id",
          "type": "string"
        },
        "orientation_xyzw": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Orientation Xyzw",
          "type": "array"
        },
        "position_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Position M",
          "type": "array"
        },
        "proxy_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Proxy Id",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "position_m",
        "orientation_xyzw",
        "proxy_id",
        "revision",
        "entity_id",
        "classification",
        "dimensions_m"
      ],
      "title": "Proxy",
      "type": "object"
    },
    "RenderAsset": {
      "additionalProperties": true,
      "properties": {
        "asset_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "attribution": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Attribution",
          "type": "string"
        },
        "bounds_max_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Bounds Max M",
          "type": "array"
        },
        "bounds_min_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Bounds Min M",
          "type": "array"
        },
        "byte_length": {
          "exclusiveMinimum": 0,
          "maximum": 2097152,
          "title": "Byte Length",
          "type": "integer"
        },
        "decoded_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 8388608,
          "title": "Decoded Bytes",
          "type": "integer"
        },
        "fallback_asset_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Asset Id"
        },
        "license": {
          "const": "CC0-1.0",
          "title": "License",
          "type": "string"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "path": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "path",
        "sha256",
        "byte_length",
        "decoded_bytes",
        "bounds_min_m",
        "bounds_max_m",
        "mandatory",
        "license",
        "attribution"
      ],
      "title": "RenderAsset",
      "type": "object"
    },
    "RoadSurface": {
      "additionalProperties": true,
      "properties": {
        "clearance_m": {
          "exclusiveMinimum": 0,
          "title": "Clearance M",
          "type": "number"
        },
        "deck_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Deck Id",
          "type": "string"
        },
        "directed_edge_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Directed Edge Id",
          "type": "string"
        },
        "entity_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Entity Id",
          "type": "string"
        },
        "lane_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Lane Id",
          "type": "string"
        },
        "normal": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Normal",
          "type": "array"
        },
        "path_samples_m": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "maxItems": 1024,
          "minItems": 2,
          "title": "Path Samples M",
          "type": "array"
        },
        "permitted_next_surface_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Permitted Next Surface Ids",
          "type": "array"
        },
        "surface_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Surface Id",
          "type": "string"
        },
        "width_m": {
          "exclusiveMinimum": 0,
          "title": "Width M",
          "type": "number"
        }
      },
      "required": [
        "surface_id",
        "entity_id",
        "lane_id",
        "deck_id",
        "directed_edge_id",
        "width_m",
        "path_samples_m",
        "normal",
        "permitted_next_surface_ids",
        "clearance_m"
      ],
      "title": "RoadSurface",
      "type": "object"
    },
    "SceneEntity": {
      "additionalProperties": true,
      "properties": {
        "asset_to_body": {
          "items": {
            "type": "number"
          },
          "maxItems": 16,
          "minItems": 16,
          "title": "Asset To Body",
          "type": "array"
        },
        "dimensions_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Dimensions M",
          "type": "array"
        },
        "entity_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Entity Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "ROAD",
            "BUILDING",
            "STOP",
            "DEPOT",
            "CHARGER",
            "SHUTTLE",
            "OBSTRUCTION"
          ],
          "title": "Kind",
          "type": "string"
        },
        "orientation_xyzw": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Orientation Xyzw",
          "type": "array"
        },
        "position_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Position M",
          "type": "array"
        },
        "proxy_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Proxy Id",
          "type": "string"
        },
        "render_asset_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Render Asset Id",
          "type": "string"
        }
      },
      "required": [
        "position_m",
        "orientation_xyzw",
        "entity_id",
        "kind",
        "dimensions_m",
        "render_asset_id",
        "proxy_id",
        "asset_to_body"
      ],
      "title": "SceneEntity",
      "type": "object"
    }
  },
  "$id": "https://formula9.local/contracts/v2/training_scene.schema.json",
  "additionalProperties": true,
  "properties": {
    "asset_profile": {
      "const": "formula9-gltf2-r1",
      "title": "Asset Profile",
      "type": "string"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/RenderAsset"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Assets",
      "type": "array"
    },
    "build_tool": {
      "const": "formula9-scene-builder-1.0",
      "title": "Build Tool",
      "type": "string"
    },
    "camera_bookmarks": {
      "items": {
        "$ref": "#/$defs/CameraBookmark"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Camera Bookmarks",
      "type": "array"
    },
    "contract_version": {
      "const": "2.1",
      "title": "Contract Version",
      "type": "string"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/SceneEntity"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Entities",
      "type": "array"
    },
    "geographic_origin": {
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Geographic Origin",
      "type": "array"
    },
    "importer_profile": {
      "const": "formula9-glb-validator-1.0",
      "title": "Importer Profile",
      "type": "string"
    },
    "local_origin_m": {
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Local Origin M",
      "type": "array"
    },
    "parent_scene_revision": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent Scene Revision"
    },
    "provenance": {
      "const": "AUTHORED_TRAINING_BLOCKOUT",
      "title": "Provenance",
      "type": "string"
    },
    "proxies": {
      "items": {
        "$ref": "#/$defs/Proxy"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Proxies",
      "type": "array"
    },
    "road_surfaces": {
      "items": {
        "$ref": "#/$defs/RoadSurface"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Road Surfaces",
      "type": "array"
    },
    "scene_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Scene Id",
      "type": "string"
    },
    "scene_revision": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Scene Revision",
      "type": "string"
    },
    "source_geography": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Source Geography",
      "type": "string"
    },
    "spatial_revision": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Spatial Revision",
      "type": "string"
    },
    "spatial_schema_version": {
      "const": "1.0",
      "title": "Spatial Schema Version",
      "type": "string"
    },
    "transform_revision": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Transform Revision",
      "type": "string"
    },
    "units": {
      "const": "metres",
      "title": "Units",
      "type": "string"
    },
    "world_basis": {
      "const": "RH_X_EAST_Y_NORTH_Z_UP",
      "title": "World Basis",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "spatial_schema_version",
    "asset_profile",
    "scene_id",
    "scene_revision",
    "spatial_revision",
    "transform_revision",
    "parent_scene_revision",
    "units",
    "world_basis",
    "geographic_origin",
    "local_origin_m",
    "source_geography",
    "provenance",
    "build_tool",
    "importer_profile",
    "assets",
    "entities",
    "proxies",
    "road_surfaces",
    "camera_bookmarks"
  ],
  "title": "TrainingSceneRevision",
  "type": "object"
}
