{
  "$defs": {
    "SessionListEntry": {
      "properties": {
        "can_archive": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Can Archive"
        },
        "can_delete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Can Delete"
        },
        "is_assessment": {
          "default": false,
          "title": "Is Assessment",
          "type": "boolean"
        },
        "occupies_capacity": {
          "title": "Occupies Capacity",
          "type": "boolean"
        },
        "scenario_revision_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Scenario Revision Id",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Session Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "DRAFT",
            "READY",
            "RUNNING",
            "PAUSED",
            "RECOVERING",
            "COMPLETED",
            "ARCHIVED",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "scenario_revision_id",
        "status",
        "occupies_capacity"
      ],
      "title": "SessionListEntry",
      "type": "object"
    }
  },
  "$id": "https://formula9.local/contracts/v2/session_list.schema.json",
  "properties": {
    "capacity": {
      "minimum": 1,
      "title": "Capacity",
      "type": "integer"
    },
    "live_count": {
      "minimum": 0,
      "title": "Live Count",
      "type": "integer"
    },
    "sessions": {
      "items": {
        "$ref": "#/$defs/SessionListEntry"
      },
      "title": "Sessions",
      "type": "array"
    },
    "terminal_practice_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Terminal Practice Count"
    },
    "total": {
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "sessions",
    "live_count",
    "total",
    "capacity"
  ],
  "title": "SessionListResponse",
  "type": "object"
}
