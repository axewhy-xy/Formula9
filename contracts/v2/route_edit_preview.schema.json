{
  "$defs": {
    "RouteCheck": {
      "additionalProperties": true,
      "properties": {
        "check": {
          "enum": [
            "GEOMETRY",
            "DIRECTION",
            "CLOSURE",
            "STOPS",
            "OPERATING_AREA",
            "VEHICLE_FIT",
            "TURNS"
          ],
          "title": "Check",
          "type": "string"
        },
        "feature_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Id"
        },
        "mandatory": {
          "default": true,
          "title": "Mandatory",
          "type": "boolean"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "WARN",
            "FAIL",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "check",
        "status",
        "message"
      ],
      "title": "RouteCheck",
      "type": "object"
    },
    "RouteMetrics": {
      "additionalProperties": true,
      "properties": {
        "distance_m": {
          "minimum": 0,
          "title": "Distance M",
          "type": "number"
        },
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "energy_kwh": {
          "minimum": 0,
          "title": "Energy Kwh",
          "type": "number"
        },
        "stop_coverage": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Stop Coverage",
          "type": "object"
        }
      },
      "required": [
        "distance_m",
        "duration_s",
        "stop_coverage",
        "energy_kwh"
      ],
      "title": "RouteMetrics",
      "type": "object"
    },
    "RoutePolylinePoint": {
      "additionalProperties": true,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "RoutePolylinePoint",
      "type": "object"
    }
  },
  "$id": "https://formula9.local/contracts/v2/route_edit_preview.schema.json",
  "additionalProperties": true,
  "properties": {
    "approvable": {
      "title": "Approvable",
      "type": "boolean"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/RouteCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "closure_revisions": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Closure Revisions",
      "type": "object"
    },
    "contract_version": {
      "default": "2.0",
      "pattern": "^2\\.[0-9]+$",
      "title": "Contract Version",
      "type": "string"
    },
    "directed_edge_ids": {
      "items": {
        "type": "string"
      },
      "title": "Directed Edge Ids",
      "type": "array"
    },
    "edited": {
      "anyOf": [
        {
          "$ref": "#/$defs/RouteMetrics"
        },
        {
          "type": "null"
        }
      ]
    },
    "fixture_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Fixture Id",
      "type": "string"
    },
    "node_ids": {
      "items": {
        "type": "integer"
      },
      "title": "Node Ids",
      "type": "array"
    },
    "original": {
      "anyOf": [
        {
          "$ref": "#/$defs/RouteMetrics"
        },
        {
          "type": "null"
        }
      ]
    },
    "polyline": {
      "items": {
        "$ref": "#/$defs/RoutePolylinePoint"
      },
      "title": "Polyline",
      "type": "array"
    },
    "preview_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Preview Id",
      "type": "string"
    },
    "preview_revision": {
      "minimum": 0,
      "title": "Preview Revision",
      "type": "integer"
    },
    "route_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Route Id",
      "type": "string"
    },
    "route_revision": {
      "minimum": 0,
      "title": "Route Revision",
      "type": "integer"
    },
    "scene_revision": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Scene Revision",
      "type": "string"
    },
    "session_epoch": {
      "minimum": 0,
      "title": "Session Epoch",
      "type": "integer"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Session Id",
      "type": "string"
    },
    "validation": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "UNKNOWN"
      ],
      "title": "Validation",
      "type": "string"
    }
  },
  "required": [
    "preview_id",
    "preview_revision",
    "session_id",
    "session_epoch",
    "route_id",
    "route_revision",
    "scene_revision",
    "fixture_id",
    "closure_revisions",
    "directed_edge_ids",
    "node_ids",
    "polyline",
    "checks",
    "validation",
    "approvable",
    "original",
    "edited"
  ],
  "title": "RouteEditPreview",
  "type": "object"
}
