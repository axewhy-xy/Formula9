<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Each page is its own file in Pages/. Open Formula 9 > Pages to preview or edit one. -->
    <ui:Template name="LoginPage" src="project://database/Assets/Formula9/UI/Pages/LoginPage.uxml" />
    <ui:Template name="MainShell" src="project://database/Assets/Formula9/UI/Pages/MainShell.uxml" />
    <Style src="Formula9App.uss" />
    <ui:VisualElement name="app" class="app">
        <ui:Instance template="LoginPage" name="login-host" class="page-host" />
        <ui:Instance template="MainShell" name="training-host" class="page-host" style="display: none;" />
    </ui:VisualElement>
</ui:UXML>
