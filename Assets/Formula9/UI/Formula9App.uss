/* The Qt client's app.qss in USS: teal shell, white cards, one accent. */
.app {
    flex-grow: 1;
    background-color: rgb(238, 244, 244);
    color: rgb(30, 42, 46);
    font-size: 14px;
}

.app Button {
    height: 34px;
    padding: 0 14px;
    margin: 0 8px 0 0;
    color: rgb(30, 42, 46);
    background-color: rgb(230, 238, 238);
    border-width: 1px;
    border-color: rgb(211, 222, 222);
    border-radius: 8px;
}

.app Button:hover { background-color: rgb(220, 232, 232); }
.app Button:disabled { color: rgb(154, 168, 170); background-color: rgb(238, 243, 243); }

.app .unity-text-field__input, .app .unity-base-popup-field__input {
    min-height: 32px;
    padding: 0 10px;
    color: rgb(30, 42, 46);
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(211, 222, 222);
    border-radius: 8px;
}

.grow { flex-grow: 1; }

/* Scrollbars everywhere: a thin rounded thumb on a clear track, with no arrow buttons. The mouse
   wheel and dragging the thumb still scroll. ".app" outranks the default theme's rules. */
.app .unity-scroller--vertical { width: 6px; min-width: 6px; margin-left: 2px; }
.app .unity-scroller--horizontal { height: 6px; min-height: 6px; margin-top: 2px; }
.app .unity-scroller__low-button, .app .unity-scroller__high-button { display: none; }
.app .unity-scroller__slider { margin: 0; padding: 0; }
.app .unity-scroller--vertical .unity-scroller__slider { width: 6px; min-width: 6px; }
.app .unity-scroller--horizontal .unity-scroller__slider { height: 6px; min-height: 6px; }
.app .unity-scroller .unity-base-slider__drag-container { margin: 0; padding: 0; }
.app .unity-scroller .unity-base-slider__tracker {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.app .unity-scroller .unity-base-slider__dragger {
    margin: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(30, 42, 46, 0.25);
}
.app .unity-scroller .unity-base-slider__dragger:hover { background-color: rgba(30, 42, 46, 0.45); }
.app .unity-scroller--vertical .unity-base-slider__dragger { left: 0; width: 6px; }
.app .unity-scroller--horizontal .unity-base-slider__dragger { top: 0; height: 6px; }
.app .unity-scroller .unity-base-slider__dragger-border { display: none; }
/* On the dark camera rail the thumb is light instead */
.app .camera-strip .unity-base-slider__dragger { background-color: rgba(255, 255, 255, 0.35); }
.app .camera-strip .unity-base-slider__dragger:hover { background-color: rgba(255, 255, 255, 0.6); }

/* The file each page is instanced from: it must fill its slot like the page inside it. */
.page-host { flex-grow: 1; flex-basis: 0; min-height: 0; }
.page-host > * { flex-grow: 1; }

.primary, .app Button.primary {
    color: rgb(255, 255, 255);
    background-color: rgb(43, 134, 153);
    border-width: 0;
    -unity-font-style: bold;
}

.primary:hover, .app Button.primary:hover { background-color: rgb(34, 112, 128); }

.danger, .app Button.danger {
    color: rgb(255, 255, 255);
    background-color: rgb(214, 48, 49);
    border-width: 0;
    -unity-font-style: bold;
}

.danger:hover, .app Button.danger:hover { background-color: rgb(186, 40, 41); }

.dialog-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.dialog {
    width: 460px;
    padding: 20px;
    border-radius: 6px;
    background-color: rgb(255, 255, 255);
}

.dialog-text { white-space: normal; margin-bottom: 16px; }
.dialog-actions { flex-direction: row; justify-content: flex-end; }

/* Login */
.login {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(40, 90, 104);
}

.login-card { width: 380px; }

.hint {
    white-space: normal;
    margin-bottom: 8px;
    color: rgb(255, 255, 255);
}

.login-field {
    flex-direction: row;
    height: 48px;
    margin-bottom: 14px;
}

.login-icon {
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.2);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.5);
}

.login-input { flex-grow: 1; flex-basis: 0; margin: 0; }

.app .login-input .unity-text-field__input {
    height: 48px;
    padding: 0 14px;
    border-width: 0;
    border-radius: 0;
    font-size: 16px;
}

.app Button.show-password {
    width: 48px;
    height: 48px;
    margin: 0;
    padding: 12px;
    border-width: 0;
    border-radius: 0;
    background-color: rgb(255, 255, 255);
}

.login-options {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

/* Checkbox first, then its label, as in the Qt login. */
.remember { flex-direction: row-reverse; }
.remember, .remember Label { color: rgb(255, 255, 255); }
.remember .unity-label { min-width: 0; margin-left: 6px; }

.error {
    white-space: normal;
    min-height: 20px;
    margin: 4px 0;
    color: rgb(255, 214, 214);
}

.app Button.login-button {
    height: 52px;
    margin: 4px 0 8px 0;
    font-size: 18px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    background-color: rgb(28, 72, 90);
    border-width: 0;
    border-radius: 0;
}

.app Button.login-button:hover { background-color: rgb(22, 60, 76); }
.app Button.login-button:disabled { color: rgb(210, 224, 228); background-color: rgb(70, 110, 124); }

.app Button.link {
    height: auto;
    margin: 0;
    padding: 2px 0;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-center;
}

.app Button.link:hover { background-color: rgba(0, 0, 0, 0); color: rgb(190, 235, 240); }

/* Shell */
.training { flex-grow: 1; flex-direction: row; }

.nav-panel {
    width: 190px;
    flex-shrink: 0;
    padding: 18px 10px;
    background-color: rgb(43, 134, 153); /* the same teal as Resume simulation and the 2D Map / 3D View switch */
    overflow:hidden;
    transition: width 0.2s ease;
}

.brand-row { 
    flex-direction: row; 
    align-items: center; 
    margin-bottom: 12px;
    padding-left:4px;
}
.nav-item Label,
.brand-names { 
    margin-left: 8px; 
    white-space:nowrap;
    flex-shrink:0;
    opacity:1;
    transition: opacity 0.12s ease 0.1s;
}

.brand-name { font-size: 22px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.brand-tagline { font-size: 10px; letter-spacing: 3px; color: rgb(185, 216, 218); }

.app Button.nav-toggle-btn {
    width: 100%;
    height: 32px;
    margin: 0 0 14px 0;
    padding: 0;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 0;
    border-radius: 6px;
    align-items: center;
    justify-content: center;
}

.app Button.nav-toggle-btn:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.nav-toggle-icon {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    transition: rotate 0.2s ease;
}

.nav-panel.collapsed .nav-toggle-icon {
    rotate: 180deg;
}

/* --- Collapsed State --- */
.nav-panel.collapsed {
    width: 56px;
    padding-left: 6px;
    padding-right: 6px;
}

.nav-panel.collapsed .brand-row {
    height: auto;
    justify-content:flex-start;
}

.nav-panel.collapsed .brand-names {
    opacity:0;
    display: none;
    transition: opacity 0.1s ease;
}

.nav-panel.collapsed .nav-item {
    height: 44px;
    padding-left: 9px;
    justify-content:flex-start;
}

.nav-panel.collapsed .nav-item-icon {
    margin-right: 0;
}

.nav-panel.collapsed .nav-item Label {
    display: none;
    opacity:0;
    transition:opacity 0.1s ease;
}

.app Button.nav-item {
    height: 44px;
    margin: 0 0 6px 0;
    padding: 0 0 0 9px;
    flex-direction: row;
    align-items: center;
    color: rgb(230, 242, 242);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 10px 0 0 10px;
    -unity-text-align: middle-left;
}

.app Button.nav-item:hover { background-color: rgba(255, 255, 255, 0.07); }

.app Button.nav-item-selected, .app Button.nav-item-selected:hover {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.14);
    border-left-color: rgb(120, 205, 210);
}

.nav-item-icon { margin-right: 10px; }

.training-body {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding: 8px 10px;
}

/* Sidebar footer: the signed-in user and the time, then Log out and Exit styled as nav items.
   Collapsed, only the icons stay, like the nav items above. */
.nav-footer { flex-shrink: 0; padding-top: 10px; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.18); }
.nav-user { flex-direction: row; align-items: center; height: 44px; padding-left: 13px; margin-bottom: 6px; }
.nav-user-text { margin-left: 0; min-width: 0; overflow: hidden; }
.nav-user-name { font-size: 14px; -unity-font-style: bold; color: rgb(255, 255, 255); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0; margin: 0; }
.nav-clock { font-size: 11px; color: rgb(185, 216, 218); white-space: nowrap; padding: 0; margin: 0; }
.nav-panel.collapsed .nav-user { padding-left: 13px; }
.nav-panel.collapsed .nav-user-text { display: none; }

.content-card {
    flex-grow: 1;
    min-height: 0;
    padding: 12px;
    border-width: 1px;
    border-radius: 12px;
    border-color: rgb(220, 230, 230);
    background-color: rgb(255, 255, 255);
}

.title { flex-grow: 1; -unity-font-style: bold; }
.mute { margin: 0 0 0 4px; }
/* The alert sounds bell: an icon button the height of the header's buttons */
.app Button.mute-button { width: 34px; height: 34px; padding: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 8px; }
.app Button.mute-button:hover { background-color: rgb(238, 244, 244); }

.row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.session-id, .session-name { flex-grow: 1; flex-basis: 200px; min-width: 200px; margin-right: 8px; }
.sessions { flex-grow: 1; flex-basis: 300px; margin-right: 8px; }
.muted { color: rgb(74, 93, 97); white-space: normal; }

/* The current simulation action sits at the right; setup and maintenance stay secondary. */
.session-header {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    padding-bottom: 8px;
    margin-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(220, 230, 230);
}

.session-heading { flex-direction: row; flex-wrap: wrap; align-items: center; flex-grow: 1; flex-basis: 340px; flex-shrink: 1; min-width: 200px; margin: 4px 12px 4px 0; }
.session-title { flex-grow: 0; flex-shrink: 1; min-width: 0; white-space: normal; margin: 4px 10px 4px 0; }
.session-badge { flex-shrink: 0; padding: 4px 10px; margin: 4px 0; border-radius: 12px; font-size: 12px; -unity-font-style: bold; color: rgb(74, 93, 97); background-color: rgb(236, 241, 242); }
.session-badge-unknown { color: rgb(74, 93, 97); background-color: rgb(236, 241, 242); }
.session-badge-ready { color: rgb(26, 106, 106); background-color: rgb(224, 243, 242); }
.session-badge-running, .session-badge-completed { color: rgb(22, 101, 52); background-color: rgb(220, 245, 228); }
.session-badge-paused, .session-badge-recovering { color: rgb(117, 76, 12); background-color: rgb(255, 242, 209); }
.session-badge-offline, .session-badge-failed { color: rgb(151, 57, 57); background-color: rgb(252, 232, 232); }
.assessment-active .session-header { border-bottom-color: rgb(112, 96, 175); }
.assessment-mode-badge, .assessment-timer {
    flex-shrink: 0;
    padding: 4px 10px;
    margin: 4px 8px 4px 0;
    border-radius: 12px;
    -unity-font-style: bold;
    color: rgb(59, 37, 121);
    background-color: rgb(237, 232, 252);
}
.assessment-mode-badge { font-size: 12px; }
.assessment-timer { margin-left: 8px; font-size: 15px; }
.assessment-timer-urgent { color: rgb(151, 42, 42); background-color: rgb(252, 225, 225); }
.session-utilities, .session-playback { flex-direction: row; align-items: center; flex-shrink: 0; margin: 4px 0; }
.session-utilities { padding-right: 16px; }
.session-playback { margin-left: auto; padding-left: 16px; border-left-width: 1px; border-left-color: rgb(211, 222, 222); }
/* Create/join training session and Assessment mode, next to the title and its badges */
.session-start { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; margin: 4px 0 4px 12px; }
/* Session setup: one bordered panel, "Start a new session" beside "Join an existing session". */
.session-setup {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-bottom: 8px;
    padding: 10px 12px 4px 12px;
    border-width: 1px;
    border-radius: 10px;
    border-color: rgb(220, 230, 230);
    background-color: rgb(247, 250, 250);
}
.session-setup-group { flex-grow: 1; flex-basis: 320px; min-width: 0; margin-bottom: 6px; }
.session-setup-new { margin-right: 16px; padding-right: 16px; border-right-width: 1px; border-right-color: rgb(220, 230, 230); }
/* A fixed height, so both columns' headings, and the boxes under them, line up */
.session-setup-heading { height: 22px; -unity-text-align: middle-left; -unity-font-style: bold; font-size: 13px; color: rgb(15, 76, 92); margin: 0 12px 6px 0; padding: 0; }
.session-setup-line { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 6px; }
/* Join an existing session's heading keeps its refresh icon close */
.session-setup-line .session-setup-heading { margin-bottom: 0; margin-right: 4px; }
/* One line, cut short rather than wrapped, so the heading line keeps its height */
.session-capacity { flex-shrink: 1; min-width: 0; font-size: 12px; margin: 0 4px 0 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* Small round icon buttons: refresh and the admin actions on the join heading, and each session's trash icon */
.app Button.session-icon-button { width: 22px; height: 22px; padding: 0; margin: 0 2px 0 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 11px; }
.app Button.session-icon-button:hover { background-color: rgb(229, 243, 242); }
.app Button.session-icon-button:disabled { background-color: rgba(0, 0, 0, 0); opacity: 0.3; }
/* A gap after the last icon, before the session count */
#reclaim-disk { margin-right: 10px; }
/* Dimmed while the list loads */
.app Button.session-refresh-loading { opacity: 0.4; }
.session-setup .sessions { margin: 0 8px 0 0; }

/* A tooltip in the running app (HoverTip): a small dark label under the hovered element */
.hover-tip { position: absolute; max-width: 320px; padding: 6px 10px; margin: 0; border-radius: 6px; font-size: 12px; white-space: normal; color: rgb(255, 255, 255); background-color: rgb(30, 42, 46); }

/* The session picker: a field like a dropdown's, and its list of sessions with a trash icon each */
.app Button.session-picker-field { flex-direction: row; align-items: center; justify-content: space-between; height: 34px; margin: 0; padding: 0 10px; background-color: rgb(255, 255, 255); border-width: 1px; border-color: rgb(211, 222, 222); border-radius: 8px; }
.app Button.session-picker-field:hover { background-color: rgb(247, 250, 250); }
.session-picker-text { flex-shrink: 1; min-width: 0; margin: 0; padding: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; }
.session-picker-arrow { flex-shrink: 0; margin: 0 0 0 6px; padding: 0; color: rgb(74, 93, 97); }
.session-picker-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.session-picker-list { position: absolute; padding: 4px 0; background-color: rgb(255, 255, 255); border-width: 1px; border-color: rgb(211, 222, 222); border-radius: 8px; }
.session-picker-row { flex-direction: row; align-items: center; padding-right: 8px; }
.app Button.session-picker-option { flex-grow: 1; flex-shrink: 1; min-width: 0; height: 30px; margin: 0 4px 0 0; padding: 0 10px; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.app Button.session-picker-option:hover { background-color: rgb(238, 244, 244); }
.app Button.session-picker-selected { -unity-font-style: bold; }

.app Button.session-button { border-width: 1px; }
.app Button.session-primary { color: rgb(255, 255, 255); background-color: rgb(43, 134, 153); border-color: rgb(43, 134, 153); -unity-font-style: bold; }
.app Button.session-primary:hover { background-color: rgb(34, 112, 128); border-color: rgb(34, 112, 128); }
.app Button.assessment-mode-button { color: rgb(255, 255, 255); background-color: rgb(74, 52, 145); border-color: rgb(74, 52, 145); -unity-font-style: bold; }
.app Button.assessment-mode-button:hover { background-color: rgb(59, 37, 121); border-color: rgb(59, 37, 121); }
.app Button.session-secondary { color: rgb(34, 112, 128); background-color: rgb(255, 255, 255); border-color: rgb(43, 134, 153); -unity-font-style: bold; }
.app Button.session-secondary:hover { background-color: rgb(229, 243, 242); }
/* Create/join training session and Join by ID are teal with white text, flipping to white with teal
   text while switched on: its panel open, or the ID field showing. After session-primary, so it wins. */
.app Button.session-toggle-open, .app Button.session-toggle-open:hover { color: rgb(43, 134, 153); background-color: rgb(255, 255, 255); border-color: rgb(43, 134, 153); }
.app Button.session-pause { color: rgb(88, 57, 10); background-color: rgb(250, 205, 111); border-color: rgb(210, 160, 60); -unity-font-style: bold; }
.app Button.session-pause:hover { background-color: rgb(242, 190, 85); }
.app Button.session-quiet { color: rgb(74, 93, 97); background-color: rgb(255, 255, 255); border-color: rgb(211, 222, 222); }
.app Button.session-quiet:hover { background-color: rgb(238, 244, 244); }
.app Button.session-caution { color: rgb(151, 57, 57); background-color: rgb(255, 255, 255); border-color: rgb(222, 188, 188); }
.app Button.session-caution:hover { background-color: rgb(252, 239, 239); border-color: rgb(188, 103, 103); }
.app Button.session-main-action { min-width: 140px; margin-right: 0; }
/* Resume simulation: a lighter teal than the other primary buttons */
.app Button.session-button:disabled, .app Button.session-button:disabled:hover { color: rgb(139, 153, 156); background-color: rgb(238, 243, 243); border-color: rgb(220, 230, 230); }

.message {
    white-space: normal;
    margin-bottom: 6px;
    color: rgb(15, 76, 92);
    -unity-font-style: bold;
}

.status { white-space: normal; margin-bottom: 10px; }
.session-status-bar { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; margin-bottom: 8px; }
.session-summary { flex-grow: 1; flex-shrink: 1; flex-basis: 240px; margin: 0 12px 0 0; color: rgb(74, 93, 97); }
.session-summary-offline { color: rgb(151, 57, 57); -unity-font-style: bold; }
.session-summary-behind { color: rgb(150, 98, 18); -unity-font-style: bold; }
.session-compact .session-header { padding-bottom: 0; margin-bottom: 8px; border-bottom-width: 0; }
.session-compact .session-heading, .session-compact .session-utilities, .session-compact .session-playback,
.session-compact .session-title, .session-compact .session-badge,
.session-compact .assessment-mode-badge, .session-compact .assessment-timer, .session-compact .session-start { margin-top: 0; margin-bottom: 0; }
.session-compact .session-status-bar { display: none; }

/* The 2D Map / 3D View switch floats over the top centre of the map on a translucent pill, so the
   map runs to the top of the card. The legend and notifications use the top-right corner and the
   camera rail the top-left, so the centre is free. */
.view-bar {
    position: absolute;
    top: 10px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: 3px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.72);
}
.app .view-bar Button.segment {
    height: 30px;
    margin: 0;
    padding: 0 14px;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
}
.app .view-bar Button.segment:hover { background-color: rgba(255, 255, 255, 0.6); }
.app .view-bar Button.segment-selected, .app .view-bar Button.segment-selected:hover { background-color: rgb(43, 134, 153); border-color: rgb(43, 134, 153); }

.app Button.segment {
    height: 40px;
    color: rgb(30, 42, 46);
    background-color: rgb(255, 255, 255);
}

.app Button.segment-selected, .app Button.segment-selected:hover {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    background-color: rgb(43, 134, 153);
    border-color: rgb(43, 134, 153);
}

/* 3D loading/failure notice, beside the switch on the same pill; hidden while empty. */
.world-notice { flex-shrink: 1; max-width: 360px; margin: 0 8px; white-space: normal; font-size: 12px; color: rgb(30, 42, 46); }

/* Map and page side by side (Route Planning); on the Fleet page the list floats over the map (body-stacked). */
.body { flex-grow: 1; flex-direction: row; min-height: 0; }
.body.body-stacked { flex-direction: column; }

.world {
    flex-grow: 3;
    flex-shrink:1;
    flex-basis: 0;
    margin-right: 8px;
    border-radius: 8px;
    background-color: rgb(26, 26, 30);
    align-items: center;
    justify-content: center;
    min-width: 0;
    overflow: hidden;
}

.fleet-panel {
    flex-grow: 2;
    flex-basis: 0;
    min-width: 340px;
    min-height: 0;
    padding: 12px;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgb(220, 230, 230);
    background-color: rgba(255, 255, 255, 0.95);
}

/* Fleet page: the Fleet List is a sheet over the bottom of the map. Collapsed, it is just its bar,
   which sits in the space the map leaves below itself, so it hides nothing. Expanded, it rises over
   the map, and the map's bottom controls move up above it. TrainingWorkspace.FitMapToFleetList
   sets the map's bottom margin from the bar's measured height; 70px is only the starting value. */
.body-stacked .world { margin-right: 0; margin-bottom: 70px; }
.body-stacked .fleet-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 45%;
    min-height: 220px;
    max-height: 100%;
    min-width: 0;
    border-color: rgb(200, 214, 214);
    background-color: rgb(255, 255, 255);
}
.body-stacked .fleet-panel.fleet-panel-collapsed { height: auto; min-height: 0; }

.fleet-table-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 4px;
    padding: 6px 15px; /* matches a card's 14px side padding + 1px border so the columns line up */
    border-radius: 6px;
    background-color: rgb(43, 134, 153);
}

.fleet-th {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 12px;
    /* No label spacing of its own, so a heading starts at its column's edge (after the column's
       padding below, which comes later and wins), exactly where the rows' text starts */
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
}
/* The rows' text likewise starts at its column's edge, so it lines up under its heading */
.fleet-col Label { margin-left: 0; margin-right: 0; padding-left: 0; padding-right: 0; }
/* The status dot hangs just left of the column, so the status text (not the dot) is under "Status" */
.fleet-col-status .status-dot { margin-left: -13px; }

/* The icon column of a card is 28px wide plus 12px margin. */
.fleet-th-icon { width: 40px; flex-shrink: 0; }

/* Column widths shared by the header and every row. The route and ETA columns share what is
   left; the incident column gives way first when the window is narrow. */
.fleet-col { min-width: 0; }
.fleet-col-id { width: 95px; flex-shrink: 0; }
.fleet-col-status { width: 120px; flex-shrink: 0; flex-direction: row; align-items: center; }
.fleet-col-battery { width: 90px; flex-shrink: 0; flex-direction: row; align-items: center; }
.fleet-col-route, .fleet-col-final { flex-grow: 1; flex-basis: 0; min-width: 100px; padding-left: 8px; padding-right: 8px; }
/* The ETA is a short duration ("4 min"), so a narrow fixed column; the incident text takes the room */
.fleet-col-eta { width: 80px; flex-shrink: 0; padding-left: 8px; padding-right: 8px; }
.fleet-col-incident { flex-grow: 1.5; flex-shrink: 1; flex-basis: 0; min-width: 180px; padding-left: 8px; }

/* The Fleet page is collapsed: the panel shrinks to its header row so the map gets the room back.
   The list is hidden rather than clipped, so the panel sizes to the header by itself. */
.fleet-panel.fleet-panel-collapsed {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
}
/* page hosts normally take 0 height and grow; collapsed, the Fleet page's host must size to its header */
.fleet-panel.fleet-panel-collapsed > .page-host { flex-grow: 0; flex-basis: auto; }
.workspace-page { flex-grow: 1; min-height: 0; }
.reports-help { white-space: normal; color: rgb(92, 107, 112); margin-bottom: 12px; }
.reports-filters { flex-direction: row; flex-wrap: wrap; align-items: flex-end; margin-bottom: 8px; }
.reports-filters > .reports-search { flex-grow: 1; flex-basis: 280px; min-width: 220px; margin-right: 12px; }
.reports-filters > .reports-select { flex-grow: 1; flex-basis: 220px; min-width: 180px; margin-right: 8px; }
.reports-filters .unity-base-field__label { min-width: 0; margin-bottom: 4px; }
.reports-search, .reports-select { flex-direction: column; }
.reports-count { color: rgb(51, 71, 75); margin-bottom: 8px; }
.reports-empty { white-space: normal; padding: 16px; border-radius: 6px; background-color: rgb(243, 247, 247); }
.login, .training { flex-grow: 1; }

.workspace-text {
    white-space: normal;
    margin-top: 6px;
    margin-bottom: 10px;
}

.route-map {
    height: 260px;
    min-height: 260px;
    background-color: rgb(26, 34, 42);
    border-radius: 4px;
    margin-bottom: 8px;
}

.world-actions {
    background-color: rgba(244, 246, 248, 0.94);
    padding: 6px;
    border-radius: 4px;
}

.data-table { flex-shrink: 0; min-height: 170px; margin-bottom: 10px; }
.data-table-body { flex-direction: column; flex-shrink: 0; }
/* The page switcher keeps its size; a tall page scrolls under it instead of squeezing it. */
.workspace-nav { flex-shrink: 0; }
.data-cell { flex-grow: 1; flex-basis: 0; min-width: 110px; white-space: normal; padding: 6px 12px; border-bottom-width: 1px; border-color: rgb(228, 232, 236); }
.data-table .unity-scroll-view__content-container { flex-grow: 1; min-width: 100%; }
.data-table-body { flex-grow: 1; }
.data-cell Button { margin: 0; height: 28px; padding: 0 8px; }
.data-heading { color: rgb(51, 71, 75); -unity-font-style: bold; background-color: rgb(243, 247, 247); }
.data-table .row { flex-wrap: nowrap; align-items: stretch; margin-bottom: 0; }

.panel-title { font-size: 17px; -unity-font-style: bold; margin-bottom: 8px; flex-shrink: 0; }
/* The search box gives way first when the header is narrow, down to 100px */
.fleet-search { flex-grow: 0; flex-shrink: 1; flex-basis: 200px; min-width: 100px; margin: 0 8px 0 0; }
.fleet-no-match { padding: 16px 4px; color: rgb(92, 107, 112); }
.fleet { flex-grow: 1;flex-basis:0; min-height: 0; }

.map-controls { position: absolute; right: 8px; bottom: 8px; width: 38px; }

.app Button.map-button, .map-compass {
    width: 38px;
    height: 38px;
    margin: 0 0 6px 0;
    padding: 9px;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 18px;
    color: rgb(30, 42, 46);
    border-width: 0;
    border-radius: 8px;
    background-color: rgb(255, 255, 255);
}

.app Button.map-text-button { padding: 0; }

.map-compass { padding: 4px 0 0 0; border-radius: 19px; }
.map-compass Label { font-size: 11px; -unity-font-style: normal; padding: 0; margin: 0; }

.map-legend {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 8px 14px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.94);
}

.app Button.map-legend-title {
    height: 22px;
    margin: 0;
    padding: 0;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    font-size: 12px;
    color: rgb(30, 42, 46);
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.app Button.map-legend-title { flex-shrink: 0; flex-direction: row; align-items: center; justify-content: space-between; }
.map-legend-title Label { margin: 0; padding: 0; -unity-font-style: bold; font-size: 12px; }
/* "‹" turned to point up while the legend is open (click to fold) and down while folded (click to
   open), the same text chevron the sidebar and Fleet List toggles use */
.map-legend-title .map-legend-chevron {
    margin-left: 10px;
    font-size: 16px;
    -unity-font-style: normal;
    color: rgb(15, 76, 92);
    rotate: 90deg;
    transition: rotate 0.2s ease;
}
.map-legend-folded .map-legend-chevron { rotate: -90deg; }
/* The rows shrink to the legend's height and scroll when FleetMap.SetBottomInset caps it */
.map-legend-rows { flex-shrink: 1; min-height: 0; }
.map-legend-row { flex-direction: row; align-items: center; margin-bottom: 3px; }
.map-legend-key { width: 26px; align-items: center; justify-content: center; }
.map-legend-row Label { font-size: 12px; color: rgb(30, 42, 46); }
.swatch-line { width: 22px; height: 4px; border-radius: 2px; }
.swatch-thin { width: 22px; height: 2px; }
.swatch-band { width: 22px; height: 9px; }
.swatch-square { width: 10px; height: 10px; border-radius: 2px; }
.swatch-dot { width: 11px; height: 11px; border-radius: 6px; }
.swatch-ring { width: 11px; height: 11px; border-radius: 6px; border-width: 3px; background-color: rgb(255, 255, 255); }

.map-banner {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 4px 10px;
    border-radius: 4px;
    color: rgb(255, 255, 255);
    background-color: rgba(190, 40, 40, 0.92);
}

.map-scale {
    position: absolute;
    left: 14px;
    bottom: 12px;
    font-size: 12px;
    padding: 0 3px;
    color: rgb(30, 42, 46);
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: rgb(30, 42, 46);
}

.fleet-card {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 10px 14px;
    margin-bottom: 6px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgb(228, 232, 236);
    background-color: rgb(255, 255, 255);
}

.fleet-card-selected {
    border-color: rgb(43, 134, 153);
    background-color: rgb(232, 244, 245);
}

.fleet-card-incident {
    border-color: rgb(214, 48, 49);
}

.bus-icon {
    width: 28px;
    height: 28px;
    margin-right: 12px;
    flex-shrink: 0;
}

.fleet-card-id {
    flex-grow: 1;
    -unity-font-style: bold;
}

.battery-gauge {
    width: 24px;
    height: 12px;
    padding: 1px;
    /* After the percentage, which comes first in the column */
    margin-left: 6px;
    border-width: 1px;
    border-radius: 2px;
    border-color: rgb(28, 34, 40);
}

.battery-fill {
    height: 100%;
}

.status-dot {
    width: 8px;
    height: 8px;
    margin-right: 5px;
    border-radius: 4px;
}

.fleet-card-line {
    font-size: 12px;
    white-space: nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
    color: rgb(96, 106, 116);
}

.fleet-incident {
    color: rgb(214, 48, 49);
    font-size: 12px;
    white-space: normal;
}

/* Fleet Panel Toggle Button */
.app Button.fleet-toggle-btn {
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
}

.app Button.fleet-toggle-btn:hover {
    background-color: rgb(228, 238, 238);
}

/* "‹" turned to point down (expanded: click to lower the list) or up (collapsed: click to raise it),
   the same text chevron the sidebar toggle uses */
.fleet-toggle-icon {
    font-size: 20px;
    color: rgb(15, 76, 92);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
    rotate: -90deg;
    transition: rotate 0.2s ease;
}

/* Title on the left, search and buttons on the right. On a narrow window the search box shrinks,
   then the tools wrap onto a second line; the map's margin follows the bar's measured height. */
.fleet-panel-header { justify-content: space-between; align-items: center; flex-wrap: wrap; min-height: 36px; margin-bottom: 8px; }
.fleet-header-title { flex-direction: row; align-items: center; flex-shrink: 0; margin-right: 12px; }
.fleet-header-tools { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: flex-end; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.fleet-header-tools Button { flex-shrink: 0; height: 30px; font-size: 11px; margin: 2px 4px 2px 0; }

/* Fleet Overview Container Scoped Collapse (Only affects the Fleet page) */
.workspace-page.fleet-overview-container {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.workspace-page.fleet-overview-container.collapsed {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
}

.workspace-page.fleet-overview-container.collapsed .fleet-panel-header { margin-bottom: 0; }

.workspace-page.fleet-overview-container.collapsed .fleet-toggle-icon {
    rotate: 90deg;
}

.fleet-body { flex-grow: 1; flex-basis: 0; min-height: 0; }
.workspace-page.fleet-overview-container.collapsed .fleet-body { display: none; }

/* Full-width pages: Route Planning, Charging, Reports, Scenarios */
.page-title { font-size: 22px; -unity-font-style: bold; margin-bottom: 10px; flex-shrink: 0; }
.tabs { flex-direction: row; flex-shrink: 0; margin-bottom: 10px; }

.app Button.tab-item {
    height: 40px;
    padding: 0 18px;
    color: rgb(51, 71, 75);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 20px;
}

.app Button.tab-item:hover { background-color: rgb(238, 244, 244); }

.app Button.tab-item-selected, .app Button.tab-item-selected:hover {
    color: rgb(15, 76, 92);
    -unity-font-style: bold;
    background-color: rgb(232, 243, 243);
    border-width: 1px;
    border-color: rgb(43, 134, 153);
}

.page-form .unity-base-field { margin: 0 0 8px 0; flex-shrink: 0; }
.page-form .unity-base-field__label { min-width: 130px; width: 130px; }
.form-row { flex-direction: row; flex-shrink: 0; margin-bottom: 8px; }
.form-label { min-width: 130px; width: 130px; flex-shrink: 0; padding-left: 2px; }
.form-value { flex-grow: 1; flex-basis: 0; white-space: normal; }

.shuttle-list {
    flex-grow: 1;
    flex-basis: 0;
    height: 110px;
    padding: 4px 8px;
    border-width: 1px;
    border-color: rgb(211, 222, 222);
    background-color: rgb(255, 255, 255);
}

.draft-actions { flex-direction: row; flex-shrink: 0; margin-bottom: 8px; }
.app .draft-actions Button { flex-grow: 1; flex-basis: 0; }
.app .draft-actions Button.draft-last { margin-right: 0; }
.route-view-actions { margin-top: 8px; }
.app Button.wide-button { margin: 8px 0; flex-shrink: 0; }

.fleet-empty { flex-grow: 1; align-items: center; justify-content: center; padding: 30px 0; }
.fleet-empty-icon { width: 120px; height: 120px; align-items: center; justify-content: center; margin-bottom: 18px; border-radius: 60px; background-color: rgb(220, 232, 232); }
.fleet-empty-title { font-size: 17px; -unity-font-style: bold; margin-bottom: 8px; }

/* The routing exercise: a sidebar of stages beside the map, in the operator's words. */
.route-stages { flex-direction: row; flex-shrink: 0; margin-bottom: 10px; }
.route-stage {
    flex-grow: 1;
    flex-basis: 0;
    height: 28px;
    margin-right: 4px;
    font-size: 12px;
    -unity-text-align: middle-center;
    color: rgb(92, 112, 116);
    background-color: rgb(230, 238, 238);
    border-radius: 6px;
}
.route-stage-done { color: rgb(15, 76, 92); background-color: rgb(209, 232, 226); }
.route-stage-current { color: rgb(255, 255, 255); -unity-font-style: bold; background-color: rgb(43, 134, 153); }

/* Every shuttle waiting for a decision, soonest first; a click opens that shuttle. */
.route-pending { flex-shrink: 0; flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 8px; }
.route-pending-title { -unity-font-style: bold; margin-right: 8px; color: rgb(190, 42, 44); }
.route-pending-items { flex-direction: row; flex-wrap: wrap; }
.app Button.route-pending-item {
    height: 26px;
    margin: 0 6px 4px 0;
    padding: 0 10px;
    font-size: 12px;
    border-radius: 13px;
    border-color: rgb(214, 48, 49);
    background-color: rgb(253, 236, 236);
}
.app Button.route-pending-item-selected { color: rgb(255, 255, 255); background-color: rgb(190, 42, 44); }

/* Incident notifications: a stack over the map's top-right corner; right is set from code. */
.notifications { position: absolute; top: 10px; right: 10px; width: 320px; max-width: 60%; }
.notifications-list { flex-direction: column; }
.notification {
    flex-shrink: 0;
    margin-bottom: 8px;
    padding: 10px 12px 8px 12px;
    border-radius: 8px;
    border-width: 1px;
    border-left-width: 5px;
    border-color: rgb(232, 196, 196);
    border-left-color: rgb(214, 48, 49);
    background-color: rgba(255, 255, 255, 0.97);
}
.notification-options { border-left-color: rgb(43, 134, 153); }
.notification-tag { font-size: 11px; -unity-font-style: bold; color: rgb(190, 42, 44); margin: 0 0 2px 0; padding: 0; }
.notification-options .notification-tag { color: rgb(15, 76, 92); }
.notification-title { font-size: 14px; -unity-font-style: bold; white-space: normal; color: rgb(30, 42, 46); margin: 0; padding: 0; }
.notification-body { font-size: 12px; white-space: normal; color: rgb(52, 70, 74); margin: 2px 0 0 0; padding: 0; }
/* Impact, time until it clears and any shuttle it is slowing, under the body in amber */
.notification-detail { font-size: 12px; white-space: normal; -unity-font-style: bold; color: rgb(146, 64, 14); margin: 4px 0 0 0; padding: 0; }
.notification-actions { flex-direction: row; justify-content: flex-end; align-items: center; margin-top: 6px; }
.app Button.notification-decide {
    height: 28px;
    margin: 0 6px 0 0;
    padding: 0 12px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 14px;
    background-color: rgb(190, 42, 44);
}
.app Button.notification-decide:hover { background-color: rgb(160, 32, 34); }
.app Button.notification-close {
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;
    font-size: 16px;
    color: rgb(74, 93, 97);
    border-width: 0;
    border-radius: 14px;
    background-color: rgba(0, 0, 0, 0);
}
.app Button.notification-close:hover { background-color: rgb(236, 240, 240); }
.app Button.notification-more {
    align-self: flex-end;
    height: 26px;
    margin: 0;
    padding: 0 12px;
    font-size: 12px;
    border-radius: 13px;
    border-color: rgb(214, 48, 49);
    background-color: rgb(253, 236, 236);
}

/* How many shuttles need a decision, on the Route Planning nav item; it stays when the panel collapses.
   A TextElement, not a Label, so the sidebar's name rules (.nav-item Label) never hide or fade it.
   TrainingWorkspace places it: at the top right of the name's last letter (over the empty space
   above the "g") but never past the item's edge, or in the icon's corner while collapsed. */
.nav-item .nav-badge {
    position: absolute;
    top: 4px;
    min-width: 16px;
    height: 16px;
    margin: 0;
    padding: 0 4px;
    border-radius: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    background-color: rgb(214, 48, 49);
}

.route-card {
    flex-shrink: 0;
    margin-bottom: 10px;
    padding: 10px 12px;
    border-width: 1px;
    border-color: rgb(220, 230, 230);
    border-radius: 8px;
    background-color: rgb(250, 252, 252);
}
.route-card-problem { border-left-width: 4px; border-left-color: rgb(214, 48, 49); }
.route-card-title { -unity-font-style: bold; margin-bottom: 4px; }
.route-card-text { white-space: normal; margin-bottom: 6px; }
.route-verdict { white-space: normal; -unity-font-style: bold; margin-bottom: 6px; }
.route-verdict-good { color: rgb(24, 122, 76); }
.route-verdict-bad { color: rgb(190, 42, 44); }
.app Button.route-link { align-self: flex-start; height: 26px; margin: 0; padding: 0 10px; font-size: 12px; }
/* Show on map, and how long the shuttle's options stand, at the far end. */
.route-problem-actions { flex-direction: row; align-items: center; min-height: 26px; }
.route-options-expiry { flex-grow: 1; -unity-text-align: middle-right; font-size: 12px; color: rgb(110, 120, 120); }

/* One button per option the backend offers the shuttle; one it does not offer is greyed out, with why as its tooltip. */
.route-card-options { border-left-width: 4px; border-left-color: rgb(43, 134, 153); }
.route-option-buttons { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-bottom: 4px; }
.app Button.route-option { height: 32px; margin: 0 6px 6px 0; padding: 0 12px; }
.app Button.route-option.segment-selected, .app Button.route-option.segment-selected:hover {
    color: rgb(255, 255, 255);
    background-color: rgb(43, 134, 153);
    border-color: rgb(43, 134, 153);
}
.route-options-hint { font-size: 12px; color: rgb(110, 120, 120); }
.route-confirm { flex-shrink: 0; margin-top: 4px; padding-top: 8px; border-top-width: 1px; border-top-color: rgb(220, 230, 230); }
.route-confirm-note { margin-top: 4px; color: rgb(110, 120, 120); }
.route-confirm-refused { color: rgb(190, 42, 44); }
.route-decide-head { flex-direction: row; align-items: center; justify-content: space-between; }

.route-waypoints { flex-shrink: 0; margin-bottom: 6px; }
.route-waypoint { flex-direction: row; align-items: center; margin-bottom: 4px; }
.route-waypoint-number {
    width: 22px;
    height: 22px;
    margin-right: 8px;
    border-radius: 11px;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    background-color: rgb(22, 101, 192);
}
.route-waypoint-name { flex-grow: 1; flex-basis: 0; white-space: normal; }
.app Button.route-waypoint-remove { width: 26px; height: 26px; margin: 0; padding: 0; }

.route-issue {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 6px;
    padding: 6px 8px;
    border-radius: 6px;
    background-color: rgb(253, 237, 236);
}
.route-issue-text { flex-grow: 1; flex-basis: 0; white-space: normal; margin-right: 8px; color: rgb(120, 28, 28); }

.route-metrics { flex-shrink: 0; margin-bottom: 4px; }
.route-metric { flex-direction: row; flex-shrink: 0; padding: 3px 0; border-bottom-width: 1px; border-bottom-color: rgb(232, 238, 238); }
.route-metric-label { flex-grow: 1; flex-basis: 0; white-space: normal; color: rgb(72, 90, 94); }
.route-metric-value { -unity-font-style: bold; margin-left: 8px; }
.route-metric-change { min-width: 90px; margin-left: 8px; -unity-text-align: upper-right; white-space: normal; color: rgb(24, 122, 76); }
.route-metric-worse { color: rgb(178, 92, 12); }
.route-basis { margin-top: 4px; font-size: 12px; }

.map-hover {
    position: absolute;
    padding: 3px 8px;
    border-radius: 6px;
    font-size: 12px;
    color: rgb(255, 255, 255);
    background-color: rgba(15, 30, 38, 0.9);
}
.map-pin-number {
    position: absolute;
    width: 22px;
    height: 22px;
    padding: 0;
    margin: 0;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}
/* Shuttle cameras: they cover the whole 3D view, one camera large with the rest as thumbnails in a
   foldable rail over its top-left corner (kept high so the Fleet List sheet does not cover it). */
.camera-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(26, 26, 30);
}
/* The large camera fills the space above the thumbnails; cropped, not stretched, to keep its shape. */
.camera-main {
    flex-grow: 1;
    -unity-background-scale-mode: scale-and-crop;
}
/* Top-left, under the large camera's name label: incident notifications use the top-right corner */
.camera-rail {
    position: absolute;
    top: 44px;
    left: 10px;
    bottom: 10px; /* WorldView.SetBottomInset raises it above the expanded Fleet List */
    align-items: flex-start;
}
.app Button.camera-rail-toggle {
    height: 28px;
    margin: 0 0 6px 0;
    padding: 0 10px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(15, 30, 38, 0.85);
}
.app Button.camera-rail-toggle:hover { background-color: rgba(43, 134, 153, 0.95); }
/* The rail's header: fold the thumbnails, or close the cameras and go back to the 3D view */
.camera-rail-bar { flex-direction: row; align-items: center; }
.camera-strip {
    flex-direction: column;
    flex-shrink: 1; /* shrinks to the rail's height and scrolls */
    min-height: 0;
    padding: 6px 6px 0 6px;
    border-radius: 8px;
    background-color: rgba(15, 30, 38, 0.85);
}
.camera-rail-collapsed .camera-strip { display: none; }
.camera-tile {
    width: 192px;
    height: 108px;
    margin: 0 0 6px 0;
    border-radius: 4px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgb(26, 26, 30);
    -unity-background-scale-mode: stretch-to-fill;
    transition: scale 0.1s ease, border-color 0.1s ease;
}
/* A thumbnail is a button: it lights up under the pointer, and a click shows it large. */
.camera-tile:hover {
    border-color: rgb(255, 255, 255);
    scale: 1.03 1.03;
}
/* The thumbnail of the camera already shown large is greyed out: it has nothing to switch to. */
.camera-tile-selected, .camera-tile-selected:hover {
    border-color: rgba(0, 0, 0, 0);
    scale: 1 1;
    -unity-background-image-tint-color: rgb(110, 110, 110);
}
.camera-tile-selected .camera-label { color: rgb(170, 178, 180); }
.camera-main .camera-label {
    left: 10px;
    top: 10px;
    bottom: auto;
    font-size: 16px;
    padding: 3px 8px;
}
.camera-label {
    position: absolute;
    left: 4px;
    bottom: 4px;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(15, 30, 38, 0.85);
}
/* Session setup folds away after joining, on every training page. */
.session-tools-hidden .session-tools { display: none; }

/* Charging page: one screen at the reference resolution */
.charge-page .unity-scroll-view__content-container { flex-grow: 1; }
.charge-header { flex-direction: row; align-items: center; flex-shrink: 0; }
.charge-title { font-size: 18px; -unity-font-style: bold; margin-right: 12px; color: rgb(15, 76, 92); }
.charge-clock { color: rgb(51, 71, 75); font-size: 12px; margin-right: 12px; }
.route-stages.charge-stages { flex-grow: 1; margin: 0; }
.charge-stages .route-stage { height: 24px; font-size: 12px; }
.charge-lock { flex-grow: 1; flex-basis: 0; padding: 1px 10px; border-radius: 6px; border-width: 0; background-color: rgb(220, 38, 38); }
.charge-lock-text { color: rgb(255, 255, 255); -unity-font-style: bold; white-space: normal; }
.charge-kpis { flex-direction: row; flex-shrink: 0; margin: 6px 0; }
.charge-kpi { flex-direction: row; align-items: center; flex-grow: 1; flex-basis: 0; margin-right: 6px; padding: 4px 10px; border-width: 0; border-left-width: 5px; border-radius: 6px; }
.charge-tone-teal { background-color: rgb(204, 243, 238); border-left-color: rgb(13, 148, 136); color: rgb(15, 94, 88); }
.charge-tone-green { background-color: rgb(209, 247, 222); border-left-color: rgb(22, 163, 74); color: rgb(20, 90, 50); }
.charge-tone-blue { background-color: rgb(214, 232, 255); border-left-color: rgb(37, 99, 235); color: rgb(30, 64, 175); }
.charge-tone-violet { background-color: rgb(233, 224, 255); border-left-color: rgb(124, 58, 237); color: rgb(91, 33, 182); }
.charge-tone-amber { background-color: rgb(255, 238, 190); border-left-color: rgb(217, 119, 6); color: rgb(146, 64, 14); }
.charge-tone-red { background-color: rgb(255, 219, 219); border-left-color: rgb(220, 38, 38); color: rgb(153, 27, 27); }
.charge-kpi-title { font-size: 12px; -unity-font-style: bold; }
.charge-kpi-value { font-size: 18px; -unity-font-style: bold; margin-right: 8px; }
.charge-card { padding: 6px 10px; margin: 0 6px 6px 0; border-width: 1px; border-top-width: 3px; border-color: rgb(205, 222, 222); border-top-color: rgb(13, 148, 136); border-radius: 6px; background-color: rgb(255, 255, 255); min-width: 0; }
.charge-card .route-card-title { margin-bottom: 3px; color: rgb(15, 76, 92); }
.charge-columns { flex-direction: row; flex-shrink: 0; }
.charge-column { flex-grow: 1; flex-basis: 0; }
.charge-queue { flex-grow: 1.2; flex-basis: 0; }
.charge-queue .data-table { min-height: 0; margin-bottom: 0; }
.charge-queue .data-cell { min-width: 0; padding: 3px 6px; white-space: nowrap; font-size: 12px; }
.charge-queue-row:hover { background-color: rgb(238, 244, 244); }
.charge-queue-selected, .charge-queue-selected:hover { background-color: rgb(190, 240, 228); border-left-width: 4px; border-left-color: rgb(43, 134, 153); }
.charge-queue-name { -unity-font-style: bold; }
.charge-battery { flex-direction: row; align-items: center; }
.charge-battery-gauge { width: 42px; height: 10px; flex-shrink: 0; margin-right: 5px; border-width: 1px; border-color: rgb(120, 140, 145); border-radius: 3px; background-color: rgb(236, 241, 241); overflow: hidden; }
.charge-battery-fill { height: 100%; }
.charge-battery-text { font-size: 12px; -unity-font-style: bold; margin: 0; padding: 0; }
.charge-battery-low { background-color: rgb(220, 38, 38); }
.charge-battery-mid { background-color: rgb(245, 158, 11); }
.charge-battery-good { background-color: rgb(22, 163, 74); }
.charge-chip { align-self: flex-start; padding: 1px 8px; margin: 0; border-radius: 9px; font-size: 11px; -unity-font-style: bold; white-space: nowrap; color: rgb(255, 255, 255); background-color: rgb(107, 114, 128); }
.charge-chip-green { background-color: rgb(21, 128, 61); }
.charge-chip-blue { background-color: rgb(29, 78, 216); }
.charge-chip-amber { background-color: rgb(251, 191, 36); color: rgb(69, 39, 5); }
.charge-chip-red { background-color: rgb(220, 38, 38); }
.charge-chip-teal { background-color: rgb(15, 118, 110); }
.charge-chip-pink { background-color: rgb(190, 24, 120); }
.charge-urgency-charging { background-color: rgb(190, 24, 120); color: rgb(255, 255, 255); }
.charge-chip-grey { background-color: rgb(107, 114, 128); }

.charge-urgency-critical { background-color: rgb(220, 38, 38); color: rgb(255, 255, 255); }
.charge-urgency-high { background-color: rgb(194, 65, 12); color: rgb(255, 255, 255); }
.charge-urgency-medium { background-color: rgb(251, 191, 36); color: rgb(69, 39, 5); }
.charge-urgency-low { background-color: rgb(21, 128, 61); color: rgb(255, 255, 255); }
.charge-urgency-none { background-color: rgb(107, 114, 128); color: rgb(255, 255, 255); }
.app Button.charge-choice { height: auto; min-height: 36px; margin: 0 0 3px 0; padding: 2px 10px; flex-direction: column; align-items: flex-start; justify-content: center; border-radius: 6px; background-color: rgb(255, 255, 255); border-width: 1px; border-color: rgb(211, 222, 222); }
.app Button.charge-choice-selected, .app Button.charge-choice-selected:hover { border-width: 2px; border-color: rgb(22, 163, 74); background-color: rgb(209, 247, 222); }
.charge-choice-title { -unity-font-style: bold; font-size: 13px; margin: 0; padding: 0; }
.charge-choice-detail { font-size: 11px; color: rgb(51, 71, 75); white-space: normal; -unity-text-align: middle-left; margin: 0; padding: 0; }
.charge-hint { font-size: 11px; color: rgb(90, 108, 112); white-space: normal; }
.charge-impact-row { flex-direction: row; justify-content: space-between; margin-bottom: 5px; }
.charge-impact-value { -unity-font-style: bold; color: rgb(21, 128, 61); }
.charge-impact-worse { color: rgb(220, 38, 38); }
.charge-schedule { flex-shrink: 0; }
.charge-schedule > .charge-header { justify-content: space-between; min-height: 28px; }
.charge-segments { flex-direction: row; flex-shrink: 0; }
.app .charge-segments Button { height: 26px; margin: 0 0 0 4px; }
.charge-timeline { flex-shrink: 0; }
.charge-time-row { flex-direction: row; height: 26px; flex-shrink: 0; margin-bottom: 2px; }
.charge-track-label { width: 120px; flex-shrink: 0; -unity-text-align: middle-left; font-size: 12px; }
.charge-track { flex-grow: 1; flex-basis: 0; position: relative; background-color: rgb(226, 236, 238); border-radius: 4px; }
.charge-track-marks { background-color: rgba(0, 0, 0, 0); }
.charge-time-mark { position: absolute; bottom: 2px; font-size: 11px; color: rgb(90, 108, 112); }
.charge-now { position: absolute; top: -1px; bottom: -1px; width: 3px; background-color: rgb(220, 38, 38); }
.charge-block { position: absolute; top: 2px; bottom: 2px; border-radius: 4px; border-width: 2px; justify-content: center; overflow: hidden; padding: 0 6px; }
.charge-block-label { font-size: 11px; -unity-font-style: bold; white-space: nowrap; margin: 0; padding: 0; -unity-text-align: middle-left; flex-grow: 1; color: rgb(255, 255, 255); }
.charge-block-live { background-color: rgb(29, 78, 216); border-color: rgb(30, 58, 138); }
.charge-block-active { background-color: rgb(21, 128, 61); border-color: rgb(20, 83, 45); }
.charge-block-draft { background-color: rgb(251, 191, 36); border-color: rgb(180, 83, 9); }
.charge-block-draft .charge-block-label { color: rgb(69, 39, 5); }
.charge-block-dragging { opacity: 0.3; }
.charge-block-ghost { top: auto; bottom: auto; border-width: 2px; }
.charge-draft-controls { flex-direction: row; align-items: center; flex-grow: 1; margin: 0 8px; }
.charge-draft-line { flex-grow: 1; font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-right; margin-right: 8px; }
.app .charge-draft-controls Button { height: 26px; margin: 0 4px 0 0; font-size: 12px; }
.charge-draft-controls .unity-base-field { margin: 0; min-width: 110px; }
.charge-bottom { flex-grow: 1; min-height: 130px; }
.charge-list { height: 104px; flex-shrink: 0; }
.charge-exceptions-card { flex-grow: 0.8; flex-basis: 0; }
.charge-bookings-card { flex-grow: 1.5; flex-basis: 0; }
.charge-bookings-card .data-table { min-height: 0; margin-bottom: 0; }
.charge-bookings-card .data-cell { min-width: 0; padding: 3px 6px; font-size: 12px; white-space: nowrap; }
.charge-apply-card { flex-grow: 0.8; flex-basis: 0; margin-right: 0; }
.charge-verdict { margin-bottom: 2px; font-size: 13px; }
.charge-issues-list { height: 32px; flex-shrink: 0; }
.charge-issues-list .route-card-text { font-size: 11px; margin-bottom: 0; }
.app Button.charge-apply { height: 32px; margin: 4px 0 0 0; color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 14px; border-width: 0; background-color: rgb(21, 128, 61); }
.app Button.charge-apply:hover { background-color: rgb(22, 101, 52); }
.charge-exception { padding: 3px 8px; margin-bottom: 3px; font-size: 12px; -unity-font-style: bold; border-left-width: 5px; border-left-color: rgb(217, 119, 6); background-color: rgb(255, 238, 190); color: rgb(146, 64, 14); white-space: normal; }
.charge-exception-severe { border-left-color: rgb(220, 38, 38); background-color: rgb(255, 219, 219); color: rgb(153, 27, 27); }
.data-cell.charge-actions { flex-direction: row; }
.data-cell.charge-actions Button { height: 22px; margin: 0 4px 0 0; padding: 0 6px; font-size: 11px; }

.charge-stages .route-stage-done { color: rgb(255, 255, 255); background-color: rgb(34, 197, 94); }
.charge-stages .route-stage-current { color: rgb(255, 255, 255); background-color: rgb(43, 134, 153); }
.charge-segments Button.segment-selected { color: rgb(255, 255, 255); background-color: rgb(43, 134, 153); }
