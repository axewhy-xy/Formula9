<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:f9="Formula9.World" xmlns:f9ui="Formula9.UI">
    <ui:Template name="FleetOverview" src="project://database/Assets/Formula9/UI/Pages/FleetOverview.uxml" />
    <ui:Template name="RoutePlanning" src="project://database/Assets/Formula9/UI/Pages/RoutePlanning.uxml" />
    <ui:Template name="Charging" src="project://database/Assets/Formula9/UI/Pages/Charging.uxml" />
    <ui:Template name="Reports" src="project://database/Assets/Formula9/UI/Pages/Reports.uxml" />
    <ui:Template name="Scenarios" src="project://database/Assets/Formula9/UI/Pages/Scenarios.uxml" />
    <Style src="project://database/Assets/Formula9/UI/Formula9App.uss" />
    <ui:VisualElement name="training" class="training">
        <ui:VisualElement name="nav-panel" class="nav-panel">
            <ui:VisualElement name="brand" class="brand-row">
                <f9:Glyph kind="Bus" tint="#FFFFFF" size="36" />
                <ui:VisualElement class="brand-names">
                    <ui:Label text="Formula9" class="brand-name" />
                    <ui:Label text="FLEET MANAGER" class="brand-tagline" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="nav-toggle-btn" class="nav-toggle-btn" tooltip="Toggle sidebar">
                <ui:Label text="‹" class="nav-toggle-icon" picking-mode="Ignore" />
            </ui:Button>
            <ui:VisualElement name="nav-items" class="nav-items">
                <ui:Button name="nav-fleet" class="nav-item" tooltip="Fleet Overview"><f9:Glyph kind="Bus" tint="#E6F2F2" class="nav-item-icon" /><ui:Label text="Fleet Overview" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="nav-route" class="nav-item" tooltip="Route Planning"><f9:Glyph kind="Pin" tint="#E6F2F2" class="nav-item-icon" /><ui:Label text="Route Planning" picking-mode="Ignore" /><ui:Label name="nav-route-badge" class="nav-badge" picking-mode="Ignore" style="display: none;" /></ui:Button>
                <ui:Button name="nav-charging" class="nav-item" tooltip="Charging"><f9:Glyph kind="Plug" tint="#E6F2F2" class="nav-item-icon" /><ui:Label text="Charging" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="nav-scenarios" class="nav-item" tooltip="Scenarios"><f9:Glyph kind="Info" tint="#E6F2F2" class="nav-item-icon" /><ui:Label text="Scenarios" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="nav-reports" class="nav-item" tooltip="Reports"><f9:Glyph kind="Document" tint="#E6F2F2" class="nav-item-icon" /><ui:Label text="Reports" picking-mode="Ignore" /></ui:Button>
            </ui:VisualElement>
            <!-- Who is signed in, the time, and leaving: at the bottom of the sidebar, in place of a top bar -->
            <ui:VisualElement class="grow" />
            <ui:VisualElement name="nav-footer" class="nav-footer">
                <ui:VisualElement class="nav-user" tooltip="Signed in">
                    <f9:Glyph kind="User" tint="#E6F2F2" class="nav-item-icon" />
                    <ui:VisualElement class="nav-user-text">
                        <ui:Label name="user" class="nav-user-name" />
                        <ui:Label name="clock" class="nav-clock" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="logout" class="nav-item" tooltip="Log out"><f9:Glyph kind="LogOut" tint="#E6F2F2" class="nav-item-icon" /><ui:Label text="Log out" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="exit-app" class="nav-item" tooltip="Exit Formula 9 (Esc)"><f9:Glyph kind="Power" tint="#E6F2F2" class="nav-item-icon" /><ui:Label text="Exit" picking-mode="Ignore" /></ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="training-body">
            <ui:VisualElement name="content-card" class="content-card">
                <ui:VisualElement class="session-header">
                    <ui:VisualElement class="session-heading">
                        <ui:Label name="title" text="Fleet training" class="title session-title" />
                        <ui:Label name="assessment-mode-badge" text="Assessment mode" class="assessment-mode-badge" style="display: none;" />
                        <ui:Label name="session-badge" text="No session" class="session-badge" />
                        <ui:Label name="assessment-timer" class="assessment-timer" style="display: none;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="session-utilities">
                        <ui:Button name="quit-assessment" text="Quit assessment mode" class="session-button session-caution" tooltip="Archive this attempt and record the assessment as disrupted." style="display: none;" />
                        <ui:Button name="session-toggle" text="Session options" class="session-button session-quiet" tooltip="Show or hide session creation, joining and deletion." style="display: none;" />
                        <!-- Only while a session is joined: before that nothing can sound -->
                        <ui:Toggle name="mute" label="Mute alert sounds" class="mute" tooltip="Silence the sounds for incidents, low batteries and lost connections. The incident notifications over the map still appear." style="display: none;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="session-playback" class="session-playback" style="display: none;">
                        <ui:Button name="archive" text="Archive session" class="session-button session-caution" tooltip="End this attempt and release its runtime slot. History remains available." />
                        <ui:Button name="start" text="Start scenario" class="session-button session-primary session-main-action" style="display: none;" />
                        <ui:Button name="pause" text="Pause simulation" class="session-button session-pause session-main-action" style="display: none;" />
                        <ui:Button name="resume" text="Resume simulation" class="session-button session-primary session-main-action" style="display: none;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- What to do first, or which session is joined: read before the setup below -->
                <ui:VisualElement class="session-status-bar">
                    <ui:Label name="status" class="status session-summary" />
                </ui:VisualElement>

                <!-- Session setup as one panel: start a new session on the left, join one on the right -->
                <ui:VisualElement class="session-tools session-setup">
                    <ui:VisualElement class="session-setup-group session-setup-new">
                        <ui:Label text="Start a new session" class="session-setup-heading" />
                        <ui:VisualElement class="session-setup-line">
                            <ui:Button name="create" text="Create training session" class="session-button session-primary" tooltip="Practise freely: no timer and no score." />
                            <ui:Button name="assessment-mode" text="Assessment mode" class="session-button assessment-mode-button" tooltip="Create and join a timed scored exercise." />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="session-setup-group session-setup-join">
                        <ui:VisualElement class="session-setup-line">
                            <ui:Label text="Join an existing session" class="session-setup-heading" />
                            <ui:Label name="capacity" text="Session list not loaded" class="muted session-capacity" />
                            <ui:Button name="refresh-sessions" text="Refresh" class="session-button session-quiet" tooltip="Reload the session list and the joined session." />
                        </ui:VisualElement>
                        <ui:VisualElement class="session-setup-line">
                            <ui:DropdownField name="sessions" class="sessions" />
                            <ui:Button name="more-sessions" text="Show more" class="session-button session-quiet" tooltip="List older sessions too." style="display: none;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="session-setup-line">
                            <ui:TextField name="session-id" class="session-id" max-length="128" />
                            <ui:Button name="join" text="Join by ID" class="session-button session-secondary" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Foldout text="Session maintenance" value="false" class="session-tools session-maintenance">
                    <ui:VisualElement class="row">
                        <ui:Button name="archive-all" text="Archive everyone's live sessions…" class="session-button session-caution" tooltip="Admin action: ends every live session on this backend, other trainees' too, and frees its slot. Their history stays available." />
                        <ui:Button name="delete-session" text="Delete permanently…" class="session-button session-caution" tooltip="Remove the selected archived, completed or failed session and all of its history, for everyone." />
                        <ui:Button name="purge-sessions" text="Delete old sessions…" class="session-button session-caution" tooltip="Permanently remove finished sessions older than the 20 newest. The dialog says how many first. Live sessions are kept." />
                        <ui:Button name="reclaim-disk" text="Reclaim disk space" class="session-button session-quiet" tooltip="Return space freed by deletions to the disk. Archive all live sessions first." />
                    </ui:VisualElement>
                </ui:Foldout>

                <ui:Label name="message" class="message" />

                <ui:VisualElement class="body">
                    <ui:VisualElement name="world" class="world">
                        <!-- Floats translucent over the top centre of the map, so the map gets the whole height.
                             Formula9App brings it in front of the layers WorldView adds. -->
                        <ui:VisualElement name="view-bar" class="view-bar">
                            <ui:Button name="view-map" text="2D Map" class="segment" />
                            <ui:Button name="view-world" text="3D View" class="segment" />
                            <ui:Label name="world-notice" class="world-notice" style="display: none;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="fleet-panel" class="fleet-panel">
                        <ui:Instance template="FleetOverview" name="page-fleet" class="page-host" />
                        <ui:Instance template="RoutePlanning" name="page-route" class="page-host" style="display: none;" />
                        <ui:Instance template="Charging" name="page-charging" class="page-host" style="display: none;" />
                        <ui:Instance template="Reports" name="page-reports" class="page-host" style="display: none;" />
                        <ui:Instance template="Scenarios" name="page-scenarios" class="page-host" style="display: none;" />
                    </ui:VisualElement>
                    <!-- Incident notifications, over the map's top-right corner (NotificationStack places it) -->
                    <ui:VisualElement name="notifications" class="notifications" picking-mode="Ignore" style="display: none;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
