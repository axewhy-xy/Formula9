<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:f9="Formula9.World" xmlns:f9ui="Formula9.UI">
    <Style src="project://database/Assets/Formula9/UI/Formula9App.uss" />
    <ui:ScrollView class="workspace-page page-form">
        <ui:Label text="Route Planning" class="page-title" />
        <ui:VisualElement class="tabs">
            <ui:Button name="route-tab-editor" text="Pre-trip routes" class="tab-item" />
            <ui:Button name="route-tab-fleet" text="Fleet table" class="tab-item" />
        </ui:VisualElement>

        <ui:VisualElement name="route-editor-panel">
            <ui:DropdownField name="routes" label="Route" />
            <ui:VisualElement class="form-row">
                <ui:Label text="Committed route" class="form-label" />
                <ui:Label name="route-committed" text="No route" class="form-value" />
            </ui:VisualElement>
            <ui:VisualElement class="form-row">
                <ui:Label text="Affected shuttles" class="form-label" />
                <ui:ScrollView name="route-shuttles" class="shuttle-list" />
            </ui:VisualElement>
            <ui:TextField name="route-via" label="Via nodes" max-length="512" placeholder-text="Optional node IDs separated by commas; empty finds a detour around closures" />
            <ui:VisualElement class="draft-actions">
                <ui:Button name="route-undo" text="Undo draft" />
                <ui:Button name="route-redo" text="Redo draft" />
                <ui:Button name="route-cancel" text="Cancel draft" class="draft-last" />
            </ui:VisualElement>
            <ui:Label text="M2 applies the route pattern to every assigned shuttle. All affected shuttles must be checked for approval." class="workspace-text" />
            <ui:Label text="Drag a node onto an interior graph node to set a waypoint, click an interior node to add it, or enter up to 16 node IDs above. Arrows show direction; thick lines show the committed route; × CLOSED marks closures; dash-dot shows the proposal." class="workspace-text" />
            <f9:RouteGraph name="route-graph" class="route-graph" />
            <ui:Button name="route-validate" text="Validate detour" class="wide-button" />
            <ui:Label name="route-status" text="Join a READY session to edit a pre-trip route." class="workspace-text" />
            <!-- The tables' headings and columns are set in TrainingWorkspace.cs; their rows come from the backend. -->
            <ui:VisualElement name="route-checks-host" />
            <ui:VisualElement name="route-comparison-host" />
            <ui:Label name="route-assumptions" class="workspace-text" />
            <ui:TextField name="route-reason" max-length="512" placeholder-text="Reason for approving this detour (required)" />
            <ui:Button name="route-approve" text="Approve validated revision" class="wide-button" />
        </ui:VisualElement>

        <ui:VisualElement name="route-fleet-panel" style="display: none;">
            <ui:VisualElement name="route-fleet-host" />
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
