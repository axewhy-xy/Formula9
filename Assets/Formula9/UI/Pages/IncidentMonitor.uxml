<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:f9="Formula9.World" xmlns:f9ui="Formula9.UI">
    <Style src="project://database/Assets/Formula9/UI/Formula9App.uss" />
    <ui:ScrollView class="workspace-page">
        <ui:Label text="Incident Monitor" class="page-title" />
        <!-- The tables' columns are set in TrainingWorkspace.cs; their rows come from the backend. -->
        <ui:VisualElement name="incident-table-host" />
        <!-- Deciding on an incident: shown once there is one. -->
        <ui:VisualElement name="incident-decisions" style="display: none;">
            <ui:DropdownField name="incidents" label="Incident" />
            <ui:Label name="incident-data" class="workspace-text" />
            <ui:VisualElement name="candidate-table-host" />
            <ui:Button name="incident-focus" text="Focus incident shuttle" />
            <ui:Button name="incident-reroute" text="Re-route on the map" tooltip="Choose the roads the held shuttle takes round the closure." style="display: none;" />
            <ui:DropdownField name="candidates" label="Option" />
            <ui:TextField name="incident-reason" label="Decision reason" max-length="2048" />
            <ui:VisualElement class="row">
                <ui:Button name="incident-preview" text="Preview option" />
                <ui:Button name="incident-approve" text="Approve previewed option" />
            </ui:VisualElement>
            <ui:Label name="incident-report" text="Previews appear here. History and Debrief are in Reports → Incidents." class="workspace-text" />
            <ui:Label name="evidence-status" class="workspace-text" />
            <f9:FleetMap name="incident-evidence-map" class="route-map" style="display: none;" />        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
