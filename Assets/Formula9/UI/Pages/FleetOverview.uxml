<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:f9="Formula9.World" xmlns:f9ui="Formula9.UI">
    <Style src="project://database/Assets/Formula9/UI/Formula9App.uss" />
    <ui:VisualElement class="workspace-page">
        <ui:Label name="fleet-title" text="Fleet List (0)" class="panel-title" />
        <ui:TextField name="fleet-search" class="fleet-search" />
        <ui:ScrollView name="fleet" class="fleet" />
        <ui:VisualElement name="fleet-empty" class="fleet-empty">
            <ui:VisualElement class="fleet-empty-icon"><f9:Glyph kind="Bus" tint="#0F4C5C" size="56" /></ui:VisualElement>
            <ui:Label text="No shuttles available" class="fleet-empty-title" />
            <ui:Label text="Join a training session to see its fleet." />
        </ui:VisualElement>
        <ui:Label name="fleet-selection" text="Select a shuttle in the fleet or map." class="workspace-text" />
        <ui:VisualElement class="row">
            <ui:Button name="follow-selected" text="Follow selected" />
            <ui:Button name="fleet-cameras" text="Cameras" tooltip="Watch the selected shuttle through its blind-spot cameras: front, rear and sides." />
            <ui:Button name="camera-overview" text="Overview" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
