# Copy to backend/.env and set a private MongoDB connection string.
# Keep the password out of source control; environment variables override this file.
MONGODB_URI=
MONGODB_DATABASE=formula9

# Free key from https://datamall.lta.gov.sg, used by: python -m src.transit.import_lta
LTA_ACCOUNT_KEY=

# Optional overrides. Defaults resolve relative to this repository, independently
# of the launch directory. Set overrides to absolute paths for portable startup.
# MAP_DATABASE_PATH=C:/path/to/map.db
# TRAINING_DATABASE_PATH=C:/path/to/training.sqlite
# TRANSIT_DATABASE_PATH=C:/path/to/transit.sqlite
# KITTI_DATA_ROOT=C:/path/to/kitti
